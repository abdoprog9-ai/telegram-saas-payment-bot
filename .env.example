# Server Configuration
PORT=3000
NODE_ENV=development
APP_BASE_URL=https://your-domain.com

# Cryptography Master Key (Must be 32 bytes hex string = 64 characters)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_MASTER_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Supabase PostgreSQL Configuration
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_ANON_KEY=your-supabase-anon-key

# Platform Main Bot Configuration
PLATFORM_BOT_TOKEN=123456789:ABCDefGhIJKlmNoPQRsTUVwxyZ
PLATFORM_BOT_SECRET=platform_bot_webhook_secret_token
